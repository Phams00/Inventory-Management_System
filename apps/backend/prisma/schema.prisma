
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum ItemType {
  RAW_MATERIAL
  WORK_IN_PROCESS
  MRO
  FINISHED_GOOD
}

enum WarehouseLocationType {
  STORAGE
  RECEIVING
  SHIPPING
  PRODUCTION
  QUARANTINE
  TRANSIT
}

enum InventoryTransactionType {
  RECEIPT
  ISSUE
  TRANSFER
  ADJUSTMENT
  PRODUCTION_ISSUE
  PRODUCTION_RECEIPT
  RETURN
}

enum InventoryTransactionStatus {
  DRAFT
  POSTED
  REVERSED
}

// ==========================================
// TENANT & USER
// ==========================================

model Company {
  id     String        @id @default(uuid()) @db.Uuid
  name   String
  code   String        @unique
  status CompanyStatus @default(ACTIVE)

  memberships           CompanyUser[]
  categories            ItemCategory[]
  units                 UnitOfMeasure[]
  warehouses            Warehouse[]
  inventoryTransactions InventoryTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companies")
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  email        String  @unique
  passwordHash String
  isActive     Boolean @default(true)

  memberships CompanyUser[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model CompanyUser {
  companyId String @db.Uuid
  userId    String @db.Uuid

  status   MembershipStatus @default(INVITED)
  joinedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([companyId, userId])
  @@index([userId, status])
  @@index([companyId, status])
  @@map("company_users")
}

// ==========================================
// MASTER DATA
// ==========================================

model ItemCategory {
  id          String  @id @default(uuid()) @db.Uuid
  companyId   String  @db.Uuid
  name        String
  description String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  items   Item[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, companyId])
  @@unique([companyId, name])
  @@index([companyId])
  @@map("item_categories")
}

model UnitOfMeasure {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  code      String
  name      String
  symbol    String

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  items   Item[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, companyId])
  @@unique([companyId, code])
  @@index([companyId])
  @@map("units_of_measure")
}

model Item {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @db.Uuid
  categoryId String   @db.Uuid
  unitId     String   @db.Uuid

  sku         String
  name        String
  description String?
  itemType    ItemType
  isActive    Boolean  @default(true)

  category ItemCategory @relation(fields: [categoryId, companyId], references: [id, companyId], onDelete: Restrict)
  unit     UnitOfMeasure @relation(fields: [unitId, companyId], references: [id, companyId], onDelete: Restrict)

  inventoryLedgerEntries InventoryLedger[]
  inventoryBalances      InventoryBalance[]
  transactionLines       InventoryTransactionLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, companyId])
  @@unique([companyId, sku])
  @@index([companyId, categoryId])
  @@index([companyId, unitId])
  @@index([companyId, itemType])
  @@map("items")
}

// ==========================================
// WAREHOUSE MANAGEMENT
// ==========================================

model Warehouse {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  code      String
  name      String
  address   String?
  isActive  Boolean @default(true)

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  locations WarehouseLocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, companyId])
  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("warehouses")
}

model WarehouseLocation {
  id          String                @id @default(uuid()) @db.Uuid
  companyId   String                @db.Uuid
  warehouseId String                @db.Uuid
  code        String
  name        String
  type        WarehouseLocationType @default(STORAGE)
  isActive    Boolean               @default(true)

  warehouse Warehouse @relation(fields: [warehouseId, companyId], references: [id, companyId], onDelete: Restrict)

  inventoryBalances      InventoryBalance[]
  inventoryLedgerEntries InventoryLedger[]
  transactionLines InventoryTransactionLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, warehouseId, companyId])
  @@unique([warehouseId, code])
  @@index([companyId, warehouseId])
  @@map("warehouse_locations")
}

// ==========================================
// INVENTORY BALANCE
// ==========================================

model InventoryBalance {
  id          String @id @default(uuid()) @db.Uuid
  companyId   String @db.Uuid
  warehouseId String @db.Uuid
  locationId  String @db.Uuid
  itemId      String @db.Uuid

  quantity         Decimal @default(0) @db.Decimal(18, 3)
  reservedQuantity Decimal @default(0) @db.Decimal(18, 3)

  item     Item              @relation(fields: [itemId, companyId], references: [id, companyId], onDelete: Restrict)
  location WarehouseLocation @relation(fields: [locationId, warehouseId, companyId], references: [id, warehouseId, companyId], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, warehouseId, locationId, itemId])
  @@index([companyId, itemId])
  @@index([companyId, warehouseId, locationId])
  @@map("inventory_balances")
}

// ==========================================
// INVENTORY TRANSACTION
// ==========================================

model InventoryTransaction {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid

  transactionNo   String
  type            InventoryTransactionType
  status          InventoryTransactionStatus @default(DRAFT)
  transactionDate DateTime @default(now())

  reference String?
  notes     String?
  postedAt  DateTime?

  // Reversal relationship
  reversalOfId String? @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  reversalOf InventoryTransaction? @relation("TransactionReversal", fields: [reversalOfId, companyId], references: [id, companyId], onDelete: Restrict)
  reversedBy InventoryTransaction? @relation("TransactionReversal")

  ledgerEntries    InventoryLedger[]
  transactionLines InventoryTransactionLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, companyId])
  @@unique([companyId, transactionNo])
  @@unique([reversalOfId, companyId])
  @@index([companyId, type, status])
  @@index([companyId, transactionDate])
  @@map("inventory_transactions")
}

// ==========================================
// INVENTORY LEDGER
// ==========================================

model InventoryLedger {
  id            String @id @default(uuid()) @db.Uuid
  companyId     String @db.Uuid
  transactionId String @db.Uuid

  warehouseId String @db.Uuid
  locationId  String @db.Uuid
  itemId      String @db.Uuid

  quantityDelta Decimal @db.Decimal(18, 3)

  transaction InventoryTransaction @relation(fields: [transactionId, companyId], references: [id, companyId], onDelete: Restrict)

  item Item @relation(fields: [itemId, companyId], references: [id, companyId], onDelete: Restrict)

  location WarehouseLocation @relation(fields: [locationId, warehouseId, companyId], references: [id, warehouseId, companyId], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([companyId, itemId, createdAt])
  @@index([companyId, warehouseId, locationId])
  @@index([transactionId, companyId])
  @@map("inventory_ledger")
}


model InventoryTransactionLine {
  id            String @id @default(uuid()) @db.Uuid
  companyId     String @db.Uuid
  transactionId String @db.Uuid

  warehouseId String @db.Uuid
  locationId  String @db.Uuid
  itemId      String @db.Uuid

  quantity Decimal @db.Decimal(18, 3)

  transaction InventoryTransaction @relation(fields: [transactionId, companyId], references: [id, companyId], onDelete: Restrict)

  item Item @relation(fields: [itemId, companyId], references: [id, companyId], onDelete: Restrict)

  location WarehouseLocation @relation(fields: [locationId, warehouseId, companyId], references: [id, warehouseId, companyId], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, transactionId])
  @@index([companyId, itemId])
  @@map("inventory_transaction_lines")
}
